# Required for both providers.
ANTHROPIC_MODEL=

# Pick ONE provider by setting its variables; ClaudeSession picks the
# direct API if ANTHROPIC_API_KEY is set, otherwise it falls back to Bedrock.

# Direct Anthropic API:
# ANTHROPIC_API_KEY=

# AWS Bedrock (default if ANTHROPIC_API_KEY is unset):
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
